# ---- 虚拟环境（绝不入库）----
.venv/
venv/
env/
ENV/

# ---- Python 缓存 ----
__pycache__/
*.py[cod]
*$py.class
*.so

# ---- 打包 / 构建产物 ----
build/
dist/
*.egg-info/
.eggs/

# ---- Jupyter ----
.ipynb_checkpoints/
*.ipynb_checkpoints

# ---- IDE ----
.vscode/
.idea/
*.swp
*.swo

# ---- 操作系统 ----
.DS_Store
Thumbs.db
desktop.ini

# ---- 大数据文件（不入库，太大）----
data/*
!data/.gitkeep

# ---- 训练产物 / 中间结果 ----
outputs/*.csv
outputs/*.pkl
outputs/*.joblib
outputs/*.h5
outputs/*.pt
outputs/*.pth

# ---- 密钥与本地配置（防止泄露）----
.env
*.key
*.pem
secrets.json
